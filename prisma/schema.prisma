generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

enum LocationType {
  ONSITE
  OFFSITE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  TESTER
  MEMBER
}

model User {
  id             String   @id @default(cuid())
  auth0Id        String   @unique // google-oauth2|xxxx
  email          String   @unique
  name           String?
  picture        String?  // Supabase storage file ID
  trelloMemberId String?  // Trello member ID for task assignment
  role           UserRole @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks          Task[]           @relation("UserTasks")
  checkins       Checkin[]
  projectMembers ProjectMember[]

  @@map("users")
}

model Worksite {
  id          String  @id @default(cuid())
  name        String
  description String?
  latitude    Decimal @db.Decimal(10, 8)
  longitude   Decimal @db.Decimal(11, 8)
  radius      Int     @default(500)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkins Checkin[]

  @@map("worksites")
}

model Checkin {
  id           String       @id @default(cuid())
  type         CheckinType
  location     LocationType @default(ONSITE)
  latitude     Decimal      @db.Decimal(10, 8)
  longitude    Decimal      @db.Decimal(11, 8)
  distance     Decimal      @db.Decimal(8, 2)
  photo        String?      // Supabase Storage URL for offsite
  reason       String?      // Required for offsite
  notes        String?
  createdAt    DateTime     @default(now())

  user         User      @relation(fields: [userId], references: [id])
  userId       String
  worksite     Worksite? @relation(fields: [worksiteId], references: [id])
  worksiteId   String?   // null for offsite checkins

  @@map("checkins")
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  key           String        @unique
  trelloBoardId String
  trelloTag     String
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  dueDate       DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tasks         Task[]
  members       ProjectMember[]

  @@map("projects")
}

model Task {
  id             String     @id @default(cuid())
  trelloCardId   String
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  assignedUserId String?
  worksiteId     String?
  projectId      String?
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignedUser   User?      @relation("UserTasks", fields: [assignedUserId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

model ProjectMember {
  id        String      @id @default(cuid())
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  isActive  Boolean     @default(true)

  user      User        @relation(fields: [userId], references: [id])
  userId    String
  project   Project     @relation(fields: [projectId], references: [id])
  projectId String

  @@unique([userId, projectId])
  @@map("project_members")
}