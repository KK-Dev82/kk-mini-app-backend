generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id        String   @id @default(cuid())
  auth0Id   String   @unique // google-oauth2|xxxx
  email     String   @unique
  name      String?
  picture   String?  // Supabase storage file ID
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]    @relation("UserTasks")
  checkins  Checkin[]

  @@map("users")
}

model Worksite {
  id          String  @id @default(cuid())
  name        String
  description String?
  latitude    Decimal @db.Decimal(10, 8)
  longitude   Decimal @db.Decimal(11, 8)
  radius      Int     @default(500)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkins Checkin[]

  @@map("worksites")
}

model Checkin {
  id         String      @id @default(cuid())
  type       CheckinType
  latitude   Decimal     @db.Decimal(10, 8)
  longitude  Decimal     @db.Decimal(11, 8)
  distance   Decimal     @db.Decimal(8, 2)
  notes      String?
  createdAt  DateTime    @default(now())

  user       User     @relation(fields: [userId], references: [id])
  userId     String
  worksite   Worksite @relation(fields: [worksiteId], references: [id])
  worksiteId String

  @@map("checkins")
}

model Task {
  id             String     @id @default(cuid())
  trelloCardId   String
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  assignedUserId String?
  worksiteId     String?
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignedUser   User?      @relation("UserTasks", fields: [assignedUserId], references: [id])

  @@map("tasks")
}